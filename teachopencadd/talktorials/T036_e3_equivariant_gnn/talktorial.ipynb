    "for ax_pos in [221, 222, 223, 224]:\n",
    "    pos = np.random.rand(3, 5)\n",
    "    color = np.random.rand(5)\n",
    "    plot_point_cloud_3d(fig, ax_pos, color, pos)\n",
    "\n",
    "fig.suptitle(\"Random test point clouds\")\n",
    "# fig.tight_layout()"
